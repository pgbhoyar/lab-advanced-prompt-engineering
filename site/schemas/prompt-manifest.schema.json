{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workshop.local/schemas/prompt-manifest.schema.json",
  "title": "Prompt Manifest",
  "description": "Metadata and file references for a reusable workshop prompt or prompt-chain stage.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "version", "lab", "variant", "purpose", "user_prompt", "variables", "model"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "lab": { "type": "string", "minLength": 1 },
    "variant": { "type": "string", "enum": ["baseline", "improved", "stage", "reference"] },
    "purpose": { "type": "string", "minLength": 1, "maxLength": 300 },
    "system_prompt": { "type": "string" },
    "user_prompt": { "type": "string", "minLength": 1 },
    "variables": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z0-9_]+$" },
      "uniqueItems": true
    },
    "output_schema": { "type": "string" },
    "test_set": { "type": "string" },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reasoning_effort", "max_output_tokens", "store"],
      "properties": {
        "reasoning_effort": { "type": "string", "enum": ["low", "medium", "high"] },
        "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 4000 },
        "store": { "type": "boolean" }
      }
    },
    "known_limitations": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "change_notes": { "type": "string" }
  }
}
