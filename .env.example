# Advanced Prompt Engineering Workshop — example environment configuration
# Copy this file to `.env` and fill in the values provided through the controlled
# workshop channel. NEVER commit `.env`. NEVER paste real keys into prompts, code,
# screenshots, logs, or chat.

# Required — Microsoft Foundry (Azure OpenAI v1 Responses API)
AZURE_OPENAI_BASE_URL=https://<resource-name>.openai.azure.com/openai/v1/
AZURE_OPENAI_API_KEY=<your-temporary-workshop-key>
AZURE_OPENAI_DEPLOYMENT=<workshop-deployment-name>

# Optional — runner behavior (defaults shown)
WORKSHOP_REASONING_EFFORT=low
WORKSHOP_MAX_OUTPUT_TOKENS=800
WORKSHOP_REQUEST_TIMEOUT_SECONDS=90
WORKSHOP_SAVE_RESULTS=false
WORKSHOP_RESULTS_DIRECTORY=generated-results
